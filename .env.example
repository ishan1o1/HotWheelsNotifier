# Railway / Environment Variables Configuration Template

# Telegram Bot Credentials (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# FirstCry API Endpoint (Optional, defaults built-in)
FIRSTCRY_API=https://www.firstcry.com/svcs/SearchResult.svc/GetSearchResultProductsFilters

# Cron Schedule Expression (Optional, default is every minute: "* * * * *")
# Example for every 5 minutes: "*/5 * * * *"
CRON_SCHEDULE=* * * * *

# Healthcheck HTTP Server Port (Provided automatically by Railway)
PORT=3000

# Persistent Data Storage Directory (Optional, for Railway Volume mount, e.g., /app/data)
DATA_DIR=./data

# Remote Logging Configuration (Optional)
LOGGER_URL=
LOGGER_API_KEY=
